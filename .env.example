# Copy to .env and fill in. Never commit the real .env file.

# LLM provider (see app/llm.py for the swappable interface)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Vector store
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=security_knowledge

# API
API_HOST=0.0.0.0
API_PORT=8000

# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secevalagent
